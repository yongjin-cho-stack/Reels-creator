# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.
#
# 열쇠는 여기(환경변수)에만 둔다. 명령줄 인자나 URL 에 넣지 않는다 —
# 그 둘은 실패하면 자기 자신을 화면에 그대로 뱉는다.

# ── 필수 ──────────────────────────────────────────────
# fal.ai — 이미지(나노바나나 프로)와 영상(클링).
#   A 키컷 · D 컷 이미지 · 영상화가 전부 이것 하나로 돈다.
#   나노바나나 프로  $0.15/장  (1K·2K 가 같은 값이라 2K 로 뽑는다. 4K 는 두 배)
#   클링 2.5 Turbo   $0.35/5초
FAL_KEY=

# 한 번 실행 비용 상한(달러). 오타 하나로 22장이 220장 되는 사고를 막는다.
AGENT_COST_LIMIT_USD=5.0

# ── 있으면 좋은 것 ────────────────────────────────────
# C-2 의 판단(전환·트림·색 기준 컷)을 자동으로 하려면 필요하다.
# 없어도 파이프라인은 돈다 — 사람이 polish/decide.json 을 직접 고치면 된다.
# 둘 중 하나만 있으면 된다.
KIMI_API_KEY=
OPENROUTER_API_KEY=

# ── 안 쓰는 것 ────────────────────────────────────────
# kitkat(B 애니매틱 · C 편집)은 **로컬 서버**라 키가 없다:
#     cd ../kitkat && npm start        →  http://127.0.0.1:5757
# TTS · 음악 생성 · 음성인식은 이번 판에서 안 쓴다
#   (대사 없음 · 무료 음원 · 원본 자막이 이미 있음)
# 저장소(S3 등)는 로컬이라 불필요. RITA 에 붙일 때만 필요해진다.
