# 생성물 — Git 에 넣지 않는다.
# 컷 11개 × 후보 2개 = 영상 22개, 개당 3~5MB → 100MB 에 육박한다.
# 한 번 올리면 지워도 기록에 남아 레포가 영구히 무거워진다.
videos/*
!videos/.gitkeep
*.mp4
*.mov
*.webm

# 키컷 후보도 양이 많다. 채택본만 손으로 올린다.
keycuts/*
!keycuts/.gitkeep
!keycuts/K1.png
!keycuts/K1.jpg

# 비용 기록은 로컬에만
cost.log

# 열쇠는 절대 올리지 않는다
.env
.env.*
!.env.example

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# 음원·오디오는 저작권이 있다. 레포에 넣지 않는다.
bgm/*
!bgm/.gitkeep
*.wav
*.mp3
*.m4a

# 생성된 컷 이미지도 양이 많다. 채택본만 손으로 올린다.
images/*
!images/.gitkeep

# 개발용 가짜 영상 — 원본 조각이다. 저작권도 있고 용량도 크다.
videos_fake/

# C-2 재료는 원본에서 뽑은 프레임이다. 다시 만들면 되고, 저작권도 있다.
polish/frames/
polish/pairs/
